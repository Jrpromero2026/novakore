# NovaKore web app environment — copy to .env.local and fill in.
# NEVER commit .env.local. NEVER put real values in this file.
# Values come from the novakore-dev Supabase project (see docs/development/supabase.md).

# --- Client-safe (inlined into browser bundles) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only. NEVER prefix these with NEXT_PUBLIC_. ---
# Optional in Phase 1A (no named internal operation requires it yet):
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI / tooling (not read by the app) ---
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
