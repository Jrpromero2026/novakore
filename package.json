{
  "name": "novakore",
  "version": "0.0.0",
  "private": true,
  "description": "NovaKore — an AI-native modular learning operating system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace=@novakore/web",
    "build": "npm run build --workspace=@novakore/web",
    "start": "npm run start --workspace=@novakore/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@novakore/web",
    "test:run": "npm run test:run --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --check",
    "test:rls": "npm run test:rls --workspace=@novakore/database",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6"
  }
}
